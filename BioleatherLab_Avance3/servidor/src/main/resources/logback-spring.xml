<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Logback local: no registrar contraseñas, tokens ni cuerpos de las solicitudes. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss} %-5level %logger{25} - %msg%n</pattern></encoder>
  </appender>
  <logger name="pe.bioleather" level="INFO"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
